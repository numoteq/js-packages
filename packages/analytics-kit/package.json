{
	"name": "@numoteq/analytics-kit",
	"version": "1.1.0",
	"description": "First-party analytics for Cloudflare Workers and Astro: a proxy to self-hosted server-side Google Tag Manager, server events through the Measurement Protocol, and a c15t preset",
	"keywords": [
		"analytics",
		"astro",
		"c15t",
		"cloudflare-workers",
		"consent",
		"google-tag-manager",
		"server-side-tagging",
		"sgtm"
	],
	"homepage": "https://github.com/numoteq/js-packages/tree/main/packages/analytics-kit#readme",
	"bugs": {
		"url": "https://github.com/numoteq/js-packages/issues"
	},
	"license": "MIT",
	"author": {
		"name": "NUMOTEQ s.r.o.",
		"email": "info@numoteq.com",
		"url": "https://www.numoteq.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/numoteq/js-packages.git",
		"directory": "packages/analytics-kit"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./client": {
			"types": "./dist/client.d.mts",
			"import": "./dist/client.mjs"
		},
		"./server": {
			"types": "./dist/server.d.mts",
			"import": "./dist/server.mjs"
		},
		"./astro": {
			"types": "./dist/astro.d.mts",
			"import": "./dist/astro.mjs"
		},
		"./c15t": {
			"types": "./dist/c15t.d.mts",
			"import": "./dist/c15t.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@c15t/integrations": "3.1.0",
		"@effect/vitest": "4.0.5",
		"astro": "7.4.0",
		"c15t": "3.1.0",
		"effect": "4.0.5",
		"tsdown": "0.23.1",
		"typescript": "6.0.3",
		"vitest": "5.0.5"
	},
	"peerDependencies": {
		"@c15t/integrations": ">=3",
		"astro": ">=6",
		"c15t": ">=3",
		"effect": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"@c15t/integrations": {
			"optional": true
		},
		"astro": {
			"optional": true
		},
		"c15t": {
			"optional": true
		}
	}
}
