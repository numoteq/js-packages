{
	"name": "@numoteq/emdash-plugin-ahasend",
	"version": "1.0.0",
	"description": "AhaSend transport provider for EmDash",
	"keywords": [
		"ahasend",
		"email",
		"emdash",
		"emdash-plugin"
	],
	"homepage": "https://github.com/numoteq/js-packages/tree/main/packages/emdash-plugin-ahasend#readme",
	"bugs": {
		"url": "https://github.com/numoteq/js-packages/issues"
	},
	"license": "MIT",
	"author": {
		"name": "NUMOTEQ s.r.o.",
		"email": "info@numoteq.com",
		"url": "https://www.numoteq.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/numoteq/js-packages.git",
		"directory": "packages/emdash-plugin-ahasend"
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs",
		"./native": {
			"import": "./dist/native/index.mjs",
			"types": "./dist/native/index.d.mts"
		},
		"./native/plugin": {
			"import": "./dist/native/plugin.mjs",
			"types": "./dist/native/plugin.d.mts"
		},
		"./client": {
			"import": "./dist/client.mjs",
			"types": "./dist/client.d.mts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "emdash-plugin validate && emdash-plugin build && tsdown",
		"dev": "emdash-plugin dev",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@ahasend/sdk": "0.3.0"
	},
	"devDependencies": {
		"@emdash-cms/plugin-cli": "0.13.4",
		"emdash": "1.3.1",
		"tsdown": "0.23.1",
		"typescript": "6.0.3",
		"vitest": "5.0.5"
	},
	"peerDependencies": {
		"emdash": ">=1.0.0"
	}
}
